# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=e2m-images    # create this bucket in Supabase dashboard with public access ON

# AI Models
ANTHROPIC_API_KEY=              # not needed for detection (kept for future use)
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=                 # from aistudio.google.com → Get API key
GEMINI_MODEL=gemini-3.1-flash-image        # render: image-in → image-out
GEMINI_VISION_MODEL=gemini-2.5-flash       # detection: image-in → JSON-out

# Google OAuth
GOOGLE_CLIENT_ID=

# Auth
JWT_SECRET=
DEV_USER_ID=dev-user-001
REQUIRE_AUTH=False

# App
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:5173"]
